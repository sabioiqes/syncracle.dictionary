        "Air": {
          "jp": "風",
          "qualities": "熱・湿"
        },
        "Earth": {
          "jp": "地",
          "qualities": "冷・乾"
        }
      },

      "interpretation_of_axes": {
        "wuxing": {
          "role": "カードの象徴が持つ展開・性質の軸"
        },
        "four_elements": {
          "role": "カードの象徴が持つ質的性格の軸"
        },
        "relationship": "五行と四元素は同一情報の重複ではなく、異なる分類軸として扱う"
      }
    },

