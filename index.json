{
  "schema_version": "1.0",

  "system": {
    "name": "Original Oracle System",
    "type": "divination",
    "purpose": "象徴を用いて現在の状況・段階・方向性を多面的に読む",
    "nature": {
      "deterministic_prediction": false,
      "fixed_future": false,
      "reflective_interpretation": true
    }
  },

  "architecture": {
    "description": "5つの異なる卜術体系を、それぞれ異なる役割を持つ5つの層として組み合わせる",

    "layers": [
      {
        "id": "core",
        "system": "Syncracle",
        "role": "中心テーマ",
        "question": "この読みの中心にあるものは何か"
      },
      {
        "id": "context",
        "system": "Geomancy",
        "role": "現在の状況・環境",
        "question": "そのテーマは現在どのような状況の中にあるか"
      },
      {
        "id": "phase",
        "system": "Ogham",
        "role": "現在の段階",
        "question": "現在はどのような段階・局面にあるか"
      },
      {
        "id": "guidance",
        "system": "Rune",
        "role": "未来への指針",
        "question": "この状況に対してどのような方向性・姿勢が示されるか"
      },
      {
        "id": "outlook",
        "system": "Bagua",
        "role": "未来の方向・展望",
        "question": "現在の流れからどのような方向性が見えるか"
      }
    ],

    "interpretation": {
      "principle": [
        "5つの結果を別々の占いとして解釈しない",
        "各結果を一つの読みの異なる層として扱う",
        "共通する象徴、意味、性質を確認する",
        "互いに補完する意味を確認する",
        "意味が異なる場合は、単純な矛盾ではなく異なる側面として検討する",
        "最終的に5つの層を統合して一つの読みを構成する"
      ],
      "priority": [
        "Syncracle",
        "Geomancy",
        "Ogham",
        "Rune",
        "Bagua"
      ]
    }
  },

  "syncracle": {
    "identity": {
      "name": "Syncracle",
      "etymology": {
        "source": [
          "syncretic",
          "oracle"
        ],
        "meaning": "異なる象徴体系を融合したオリジナル・オラクル"
      },
      "type": "original_oracle",
      "card_count": 40
    },

    "origin": {
      "basis": [
        "Lenormand",
        "coffee cards"
      ],
      "description": [
        "Lenormandとコーヒーカードをベースとして構成されたオリジナルのカード体系",
        "既存のカード体系をそのまま再現するものではなく、独自のカード名・象徴・意味を設定している",
        "各カードに五行と四元素を付与し、カード固有の象徴とは別の性質情報として扱う"
      ]
    },

    "concept": {
      "description": [
        "カードそのものが持つ象徴的意味と、五行・四元素による性質を組み合わせて読む",
        "一枚のカードを単一のキーワードに固定せず、複数の意味領域を持つ象徴として扱う",
        "カードの意味、五行、四元素を組み合わせることで、同じ象徴が異なる文脈で異なる現れ方をすることを表現する"
      ]
    },

    "structure": {
      "card_count": 40,

      "classification": {
        "primary": "card_symbolism",
        "additional_axes": [
          "wuxing",
          "four_elements"
        ]
