  "reading_rules": {
    "input": {
      "description": "Syncracle、Geomancy、Ogham、Rune、Baguaの5つの結果を入力として受け取る"
    },

    "process": [
      {
        "step": 1,
        "action": "Syncracleから読み全体の中心テーマを特定する"
      },
      {
        "step": 2,
        "action": "Geomancyから、そのテーマが置かれている現在の状況・環境を読む"
      },
      {
        "step": 3,
        "action": "Oghamから、現在がどのような段階・局面にあるかを読む"
      },
      {
        "step": 4,
        "action": "Runeから、状況に対してどのような指針・方向性が示されるかを読む"
      },
      {
        "step": 5,
        "action": "Baguaから、現在の流れから見える未来の方向・展望を読む"
      },
      {
        "step": 6,
        "action": "5つの結果に共通する象徴・意味・性質を確認する"
      },
      {
        "step": 7,
        "action": "異なる結果の間にある補完関係・対照・緊張関係を確認する"
      },
      {
        "step": 8,
        "action": "各層の役割を維持したまま、5つの結果を一つの読みとして統合する"
      }
    ],

    "interpretation": {
      "syncracle": {
        "priority": "中心テーマを形成する",
        "use": [
          "カード固有の意味を読む",
          "五行による性質を読む",
          "四元素による性質を読む",
          "それらを組み合わせて中心テーマを形成する"
        ]
      },
      "geomancy": {
        "priority": "現在の状況を補足する",
        "use": [
          "中心テーマが置かれている環境を見る",
          "現在進行している状況を見る"
        ]
      },
      "ogham": {
        "priority": "現在の段階を補足する",
        "use": [
          "状況がどの段階にあるかを見る",
          "変化・停滞・転換などの局面を読む"
        ]
      },
      "rune": {
        "priority": "行動・姿勢への指針を補足する",
        "use": [
          "現在の状況に対する方向性を見る",
          "どのような姿勢・行動が示されるかを読む"
        ]
      },
      "bagua": {
        "priority": "未来の方向を補足する",
        "use": [
          "現在の流れが向かう方向を見る",
          "その方向が持つ性質を見る",
          "五行を補助情報として用いる"
        ]
      }
    },

    "synthesis": {
      "required": [
        "各術式の役割を維持する",
        "単一のカードや結果だけで結論を決めない",
        "複数の結果に現れる共通性を重視する",
        "異なる結果は、それぞれ異なる層から見た情報として扱う",
        "最終的には5つの結果を統合した一つの読みを提示する"
      ]
    },

    "constraints": [
      "未来を確定事項として表現しない",
      "吉凶だけで判断しない",
      "カードやシンボルの意味を単一のキーワードに固定しない",
      "五行と四元素を同一の分類として扱わない",
      "Syncracleの五行・四元素と、Baguaの五行を混同しない",
      "Geomancy、Ogham、Rune、Baguaの役割をSyncracleのカード解釈に置き換えない"
    ]
  }
}
